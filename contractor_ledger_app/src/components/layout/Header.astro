---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/#core-calculators', label: 'All 6 Calculators' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const calculatorLinks = [
  { href: '/calculators/job-pricing/', label: 'Job Pricing' },
  { href: '/calculators/labor-cost/', label: 'Labor Cost' },
  { href: '/calculators/profit-margin/', label: 'Profit Margin' },
  { href: '/calculators/break-even/', label: 'Break-Even' },
  { href: '/calculators/material-markup/', label: 'Material Markup' },
  { href: '/calculators/project-estimate/', label: 'Project Estimate' },
];
---

<header class="sticky top-0 z-40 w-full bg-graphite border-b border-graphite-border shadow-subtle">
  <div class="max-w-container mx-auto px-4 sm:px-6 min-h-16 sm:min-h-18 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 shrink-0 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-copper rounded p-1">
      <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-md bg-brand-copper flex items-center justify-center text-white group-hover:bg-brand-copper-hover transition-colors" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="M7 15h0M2 10h20" />
          <circle cx="16" cy="15" r="1" fill="currentColor" />
        </svg>
      </div>
      <span class="font-extrabold text-sm sm:text-base tracking-tight text-white font-headline leading-tight whitespace-nowrap">
          Contractor Ledger
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-4 xl:gap-6 h-full" aria-label="Main navigation">
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/#core-calculators' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`h-full flex items-center border-b-2 text-sm font-medium transition-colors whitespace-nowrap ${
              isActive ? 'text-white border-brand-copper font-semibold' : 'text-text-inverse-muted border-transparent hover:text-white'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <button
        type="button"
        id="open-settings-header-btn"
        class="h-11 w-11 sm:w-auto sm:px-3 rounded-md border border-graphite-border bg-graphite-raised hover:bg-graphite-hover text-xs font-semibold text-white transition-colors flex items-center justify-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-copper"
        aria-label="Open Contractor Cost Settings"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-inverse-muted" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        <span class="hidden sm:inline">Cost Settings</span>
      </button>

      <a
        href="/calculators/job-pricing/"
        class="hidden sm:flex min-h-11 px-4 rounded-md bg-brand-copper hover:bg-brand-copper-hover text-white text-sm font-semibold transition-colors items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-copper"
      >
        Calculate Job Price
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="h-11 w-11 lg:hidden rounded-md border border-graphite-border bg-graphite-raised hover:bg-graphite-hover text-white flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-copper"
        aria-label="Open navigation menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <svg data-menu-icon="open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg data-menu-icon="close" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-navigation" class="hidden lg:hidden max-h-[calc(100dvh_-_4rem)] overflow-y-auto overscroll-contain border-t border-graphite-border bg-graphite px-4 sm:px-6 py-3" aria-label="Mobile navigation">
    <ul class="max-w-container mx-auto space-y-1">
      <li>
        <a
          href="/"
          aria-current={currentPath === '/' ? 'page' : undefined}
          class={`block min-h-11 rounded px-3 py-3 text-sm font-medium ${currentPath === '/' ? 'bg-graphite-raised text-white font-semibold' : 'text-text-inverse-muted hover:bg-graphite-raised hover:text-white'}`}
        >
          Home
        </a>
      </li>
      <li class="px-3 pt-3 pb-1 text-xs font-bold uppercase tracking-wider text-text-inverse-muted">Calculators</li>
      {calculatorLinks.map(link => {
        const isActive = currentPath === link.href;
        return (
          <li>
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`block min-h-11 rounded px-3 py-3 text-sm font-medium ${isActive ? 'bg-graphite-raised text-white font-semibold' : 'text-text-inverse-muted hover:bg-graphite-raised hover:text-white'}`}
            >
              {link.label}
            </a>
          </li>
        );
      })}
      <li class="px-3 pt-3 pb-1 text-xs font-bold uppercase tracking-wider text-text-inverse-muted">More</li>
      {navLinks.map(link => {
        const isActive = currentPath === link.href || (link.href !== '/#core-calculators' && currentPath.startsWith(link.href));
        return (
          <li>
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`block min-h-11 rounded px-3 py-3 text-sm font-medium ${isActive ? 'bg-graphite-raised text-white font-semibold' : 'text-text-inverse-muted hover:bg-graphite-raised hover:text-white'}`}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const settingsBtn = document.getElementById('open-settings-header-btn');
  settingsBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-cost-settings'));
  });

  const menuButton = document.getElementById('mobile-menu-toggle');
  const mobileNavigation = document.getElementById('mobile-navigation');
  const openMenuIcon = menuButton?.querySelector('[data-menu-icon="open"]');
  const closeMenuIcon = menuButton?.querySelector('[data-menu-icon="close"]');

  const setMenuOpen = (isOpen: boolean, returnFocus = false) => {
    if (!menuButton || !mobileNavigation) return;
    mobileNavigation.classList.toggle('hidden', !isOpen);
    menuButton.setAttribute('aria-expanded', String(isOpen));
    menuButton.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    openMenuIcon?.classList.toggle('hidden', isOpen);
    closeMenuIcon?.classList.toggle('hidden', !isOpen);
    if (returnFocus) menuButton.focus();
  };

  menuButton?.addEventListener('click', () => {
    const willOpen = menuButton.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(willOpen);
  });

  mobileNavigation?.addEventListener('click', event => {
    if (event.target instanceof Element && event.target.closest('a')) setMenuOpen(false);
  });

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false, true);
    }
  });
</script>
