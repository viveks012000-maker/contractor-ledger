---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/#core-calculators', label: 'All 6 Calculators' },
  { href: '/methodology/', label: 'Methodology' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="sticky top-0 z-40 w-full bg-surface/95 backdrop-blur-md border-b border-border-default shadow-subtle">
  <div class="max-w-container mx-auto px-4 sm:px-6 h-18 flex items-center justify-between gap-4">
    <!-- Brand Mark -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded p-1">
      <div class="w-9 h-9 rounded bg-brand-green flex items-center justify-center text-white shadow-xs group-hover:bg-brand-green-hover transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="M7 15h0M2 10h20" />
          <circle cx="16" cy="15" r="1" fill="currentColor" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-base tracking-tight text-text-primary font-headline group-hover:text-brand-green transition-colors leading-tight">
          Contractor Ledger
        </span>
        <span class="text-[10px] font-semibold tracking-wider uppercase text-text-secondary leading-none mt-0.5">
          Fiscal Precision Engine
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Main Navigation">
      {navLinks.map(link => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class={`text-sm font-medium transition-colors py-1 ${
              isActive ? 'text-brand-green font-semibold' : 'text-text-secondary hover:text-text-primary'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Cost Settings Button (Opens LocalStorage Defaults Modal) -->
      <button
        type="button"
        id="open-settings-header-btn"
        class="h-10 px-3 rounded border border-border-default bg-surface hover:bg-canvas text-xs font-semibold text-text-primary transition-colors flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green"
        aria-label="Open Contractor Cost Settings"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
        <span class="hidden sm:inline">Cost Settings</span>
      </button>

      <!-- Primary Action CTA -->
      <a
        href="/calculators/job-pricing/"
        class="h-10 px-4 rounded bg-brand-green hover:bg-brand-green-hover text-white text-xs font-semibold transition-colors flex items-center justify-center shadow-xs focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green"
      >
        Calculate Job Price
      </a>
    </div>
  </div>
</header>

<script>
  const settingsBtn = document.getElementById('open-settings-header-btn');
  if (settingsBtn) {
    settingsBtn.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-cost-settings'));
    });
  }
</script>
