---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AdSlot } from '../components/ui/AdSlot';

const title = 'About Contractor Ledger | Free Contractor Estimating Tools';
const description = 'Learn what Contractor Ledger calculators do, how estimates are calculated, and what the results include.';
---

<BaseLayout title={title} description={description} canonicalPath="/about/">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">About</span>
    </nav>

    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        About Contractor Ledger
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Contractor Ledger is a set of free browser-based estimating calculators for contractors. Enter your own job costs to estimate prices, labor, materials, break-even rates, and project totals.
      </p>
    </div>

    <!-- Core Philosophy -->
    <article class="bg-surface rounded-xl border border-border-default p-6 sm:p-8 shadow-subtle space-y-5">
      <h2 class="text-xl font-bold text-text-primary font-headline">
        Tools for Everyday Estimating
      </h2>
      <div class="space-y-4 text-sm text-text-secondary leading-relaxed">
        <p>
          The six calculators cover job pricing, labor cost, margin and markup, break-even, material markup, and itemized project estimates. Each shows the values it uses and updates its result as you make changes.
        </p>
        <p>
          The estimates reflect only the numbers entered. They do not verify supplier prices, labor rates, taxes, fees, insurance, or other costs that may apply to a job.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3">
          <div class="p-4 rounded-lg bg-canvas border border-border-default">
            <h3 class="font-bold text-text-primary text-sm mb-1">Useful for</h3>
            <ul class="text-xs text-text-secondary space-y-1.5 list-disc list-inside">
              <li>Estimating labor, materials, and overhead</li>
              <li>Comparing target margin and markup</li>
              <li>Building itemized project totals</li>
              <li>Saving optional cost defaults in this browser</li>
            </ul>
          </div>

          <div class="p-4 rounded-lg bg-canvas border border-border-default">
            <h3 class="font-bold text-text-primary text-sm mb-1">Keep in mind</h3>
            <ul class="text-xs text-text-secondary space-y-1.5 list-disc list-inside">
              <li>Results depend on the assumptions you enter</li>
              <li>Missing costs are not added automatically</li>
              <li>Currency amounts are rounded to cents</li>
              <li>Estimates are not a guaranteed bid or profit</li>
            </ul>
          </div>
        </div>
      </div>
    </article>

    <!-- Engineering Architecture -->
    <article class="bg-surface rounded-xl border border-border-default p-6 sm:p-8 shadow-subtle space-y-4">
      <h2 class="text-xl font-bold text-text-primary font-headline">
        How Calculations Run
      </h2>
      <div class="space-y-3 text-sm text-text-secondary leading-relaxed">
        <p>
          Calculations run in your browser using the values you enter. The site does not send calculator inputs to a calculation service.
        </p>
        <p>
          If you save shared cost defaults, they are stored in this browser until you clear them. The page also requests fonts from Google Fonts; see the Privacy Policy for more detail.
        </p>
      </div>
    </article>

    <!-- AdSense Placement -->
    <AdSlot slotId="about-banner" />
  </div>
</BaseLayout>
