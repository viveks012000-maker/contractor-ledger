---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ProfitMarginCalculator } from '../../components/calculators/ProfitMarginCalculator';
import { AdSlot } from '../../components/ui/AdSlot';

const title = 'Profit Margin Calculator | Margin vs. Markup Engine';
const description = 'Calculate gross profit margin vs markup on cost. Analyze existing prices or compute the required selling price to hit your margin target.';
---

<BaseLayout title={title} description={description} canonicalPath="/calculators/profit-margin/" includeWebApplicationSchema={true}>
  <div class="max-w-container mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/#core-calculators" class="hover:text-text-primary transition-colors">Calculators</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">Profit Margin</span>
    </nav>

    <!-- Page Heading -->
    <div class="max-w-3xl space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Profit Margin vs. Markup Calculator
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Compare gross margin with markup on cost. Use Mode A to analyze an entered price or Mode B to calculate a price for your selected gross margin.
      </p>
    </div>

    <!-- Interactive Calculator -->
    <ProfitMarginCalculator client:load />

    <!-- AdSense Non-Intrusive Slot -->
    <AdSlot slotId="profit-margin-bottom-banner" />

    <!-- Technical Guide & Comparison Table -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6 border-t border-border-default">
      <!-- Left: Theoretical Principles -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h2 class="text-lg font-bold font-headline text-text-primary">
          Why Margin and Markup Are Different
        </h2>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Although both metrics describe profitability, they measure against two completely different denominators:
          </p>
          <div class="p-3 rounded bg-canvas border border-border-default font-mono text-xs text-text-primary space-y-1.5">
            <div><strong>Profit Margin:</strong> Profit ÷ Selling Price</div>
            <div>Measures the portion of the customer's payment that remains as profit.</div>
            <div class="pt-1"><strong>Markup:</strong> Profit ÷ Total Cost</div>
            <div>Measures the percentage added on top of your job expenses.</div>
          </div>
          <p>
            On a profitable job, markup is a higher percentage than margin because it uses the smaller total-cost amount as its denominator. Confusing the two can lead to a price below the one needed for your selected margin.
          </p>
        </div>
      </div>

      <!-- Right: Conversion Matrix Reference -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h2 class="text-lg font-bold font-headline text-text-primary">
          Margin to Markup Conversion Matrix
        </h2>
        <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Margin to markup conversion matrix">
          <table class="w-full text-xs text-left">
            <thead class="bg-canvas border-b border-border-default text-text-primary font-bold">
              <tr>
                <th class="py-2 px-3">Target Margin</th>
                <th class="py-2 px-3">Required Markup</th>
                <th class="py-2 px-3">On $1,000 Cost</th>
                <th class="py-2 px-3">Selling Price</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border-default text-text-secondary font-medium tabular-nums">
              <tr>
                <td class="py-2 px-3 font-bold text-text-primary">10.0%</td>
                <td class="py-2 px-3">11.1%</td>
                <td class="py-2 px-3">$100.00 profit</td>
                <td class="py-2 px-3 font-semibold text-text-primary">$1,111.11</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-bold text-text-primary">15.0%</td>
                <td class="py-2 px-3">17.6%</td>
                <td class="py-2 px-3">$150.00 profit</td>
                <td class="py-2 px-3 font-semibold text-text-primary">$1,176.47</td>
              </tr>
              <tr class="bg-brand-copper-light/40">
                <td class="py-2 px-3 font-bold text-brand-copper">20.0%</td>
                <td class="py-2 px-3 font-semibold">25.0%</td>
                <td class="py-2 px-3">$200.00 profit</td>
                <td class="py-2 px-3 font-bold text-brand-copper">$1,250.00</td>
              </tr>
              <tr class="bg-brand-copper-light/60 font-semibold">
                <td class="py-2 px-3 font-bold text-brand-copper">25.0%</td>
                <td class="py-2 px-3 font-semibold">33.3%</td>
                <td class="py-2 px-3">$250.00 profit</td>
                <td class="py-2 px-3 font-bold text-brand-copper">$1,333.33</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-bold text-text-primary">30.0%</td>
                <td class="py-2 px-3">42.9%</td>
                <td class="py-2 px-3">$300.00 profit</td>
                <td class="py-2 px-3 font-semibold text-text-primary">$1,428.57</td>
              </tr>
              <tr>
                <td class="py-2 px-3 font-bold text-text-primary">40.0%</td>
                <td class="py-2 px-3">66.7%</td>
                <td class="py-2 px-3">$400.00 profit</td>
                <td class="py-2 px-3 font-semibold text-text-primary">$1,666.67</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <p class="text-xs text-text-secondary leading-relaxed">
      Calculated profit reflects only the cost and selling price entered. It excludes expenses, taxes, or fees not included in those amounts; currency results are rounded to cents.
    </p>

    <!-- Related Calculators Directory -->
    <div class="pt-8 border-t border-border-default">
      <h2 class="text-sm font-bold uppercase tracking-wider text-text-primary font-headline mb-4">
        Related Financial Tools
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/calculators/job-pricing/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h3 class="text-sm font-bold text-text-primary mb-1">Job Pricing Calculator</h3>
          <p class="text-xs text-text-secondary">Apply your target margin directly to direct expenses and allocated overhead.</p>
        </a>
        <a href="/calculators/material-markup/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h3 class="text-sm font-bold text-text-primary mb-1">Material Markup Calculator</h3>
          <p class="text-xs text-text-secondary">Determine markups specifically on lumber, supplies, and fixtures.</p>
        </a>
        <a href="/calculators/break-even/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h3 class="text-sm font-bold text-text-primary mb-1">Break-Even Calculator</h3>
          <p class="text-xs text-text-secondary">Calculate the minimum hourly revenue needed before generating profit.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
