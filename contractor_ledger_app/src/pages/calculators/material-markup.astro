---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { MaterialMarkupCalculator } from '../../components/calculators/MaterialMarkupCalculator';
import { AdSlot } from '../../components/ui/AdSlot';

const title = 'Material Markup Calculator | Waste, Price and Profit';
const description = 'Set a material selling price using quantity, unit cost, expected waste, and markup.';
---

<BaseLayout title={title} description={description} canonicalPath="/calculators/material-markup/">
  <div class="max-w-container mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/#core-calculators" class="hover:text-text-primary transition-colors">Calculators</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">Material Markup</span>
    </nav>

    <!-- Page Heading -->
    <div class="max-w-3xl space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Material Markup &amp; Waste Calculator
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Use this for a material line item. Enter quantity, unit cost, expected waste, and markup to see the adjusted cost, amount to bill, and profit. Labor and overhead are not included unless you add them elsewhere in your estimate.
      </p>
      <p class="text-sm font-medium text-text-secondary">Enter quantity and cost below. The adjusted material price updates as you change the assumptions.</p>
    </div>

    <!-- Interactive Calculator -->
    <MaterialMarkupCalculator client:load />

    <!-- AdSense Non-Intrusive Slot -->
    <AdSlot slotId="material-markup-bottom-banner" />

    <!-- Technical Guide & Worked Example -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6 border-t border-border-default">
      <!-- Left: Formulas and Definitions -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h3 class="text-lg font-bold font-headline text-text-primary">
          Procurement Waste &amp; Markup Logic
        </h3>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Add the expected waste to the quantity, then apply the unit cost and markup. Use a realistic waste allowance for the material and job rather than assuming every project needs the same amount:
          </p>
          <div class="p-3 rounded bg-canvas border border-border-default font-mono text-xs text-text-primary space-y-1">
            <div>Effective Quantity = Net Quantity × (1 + Waste Allowance % ÷ 100)</div>
            <div>Adjusted Material Cost = Effective Quantity × Unit Cost</div>
            <div>Markup Dollar Amount = Adjusted Cost × Markup % ÷ 100</div>
            <div class="font-bold text-brand-copper">Selling Price = Adjusted Cost + Markup Amount</div>
            <div>Resulting Profit Margin (%) = (Markup Amount ÷ Selling Price) × 100</div>
          </div>
          <p>
            <strong>Fractional Quantities:</strong> Supports decimals for cubic yards of concrete, linear feet of trim, pounds of fasteners, and tonnage of aggregate.
          </p>
        </div>
      </div>

      <!-- Right: Worked Example & Verification -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h3 class="text-lg font-bold font-headline text-text-primary">
          Worked Example
        </h3>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Purchasing and billing specialty architectural hardware:
          </p>
          <ul class="list-disc list-inside space-y-1 text-text-primary font-medium">
            <li>Quantity: 1.0 unit</li>
            <li>Wholesale Unit Cost: $100.00</li>
            <li>Waste Allowance: 0%</li>
            <li>Target Markup: 25.0%</li>
          </ul>
          <div class="p-3 rounded bg-brand-copper-light/50 border border-brand-copper-border text-xs space-y-1">
            <div class="font-semibold text-text-primary">Calculated Outputs:</div>
            <div>Adjusted Cost Basis = 1.0 × $100.00 = $100.00</div>
            <div>Markup Dollar Amount = $100.00 × 0.25 = $25.00</div>
            <div class="font-bold text-brand-copper">Selling Price = $100.00 + $25.00 = $125.00</div>
            <div class="font-bold text-profit-positive">Profit Generated = $25.00</div>
            <div>Resulting Profit Margin = ($25.00 ÷ $125.00) × 100 = 20.0%</div>
          </div>
          <p class="text-text-muted">
            Notice that applying a 25% markup to material cost produces a 20% margin on the billed line item.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Calculators Directory -->
    <div class="pt-8 border-t border-border-default">
      <h3 class="text-sm font-bold uppercase tracking-wider text-text-primary font-headline mb-4">
        Related Financial Tools
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/calculators/job-pricing/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Job Pricing Calculator</h4>
          <p class="text-xs text-text-secondary">Fold marked-up materials into an overall project price alongside labor.</p>
        </a>
        <a href="/calculators/profit-margin/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Profit Margin Calculator</h4>
          <p class="text-xs text-text-secondary">Analyze markups across total job invoices versus line-item supplies.</p>
        </a>
        <a href="/calculators/project-estimate/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Project Estimate Ledger</h4>
          <p class="text-xs text-text-secondary">Enter multiple itemized material line items with dedicated category subtotals.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
