---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { JobPricingCalculator } from '../../components/calculators/JobPricingCalculator';
import { AdSlot } from '../../components/ui/AdSlot';

const title = 'Job Pricing Calculator | Defensible Cost-Plus Recovery';
const description = 'Calculate profitable job prices based on direct labor, materials, equipment, overhead allocation, and target gross margin.';
---

<BaseLayout title={title} description={description} canonicalPath="/calculators/job-pricing/" includeWebApplicationSchema={true}>
  <div class="max-w-container mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/#core-calculators" class="hover:text-text-primary transition-colors">Calculators</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">Job Pricing</span>
    </nav>

    <!-- Page Heading -->
    <div class="max-w-3xl space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Job Pricing Calculator
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Estimate a job price from the direct costs and overhead you enter, using a target gross margin as a share of the selling price.
      </p>
    </div>

    <!-- Interactive Calculator -->
    <JobPricingCalculator client:load />

    <!-- AdSense Non-Intrusive Slot -->
    <AdSlot slotId="job-pricing-bottom-banner" />

    <!-- Technical Guide & Worked Example -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6 border-t border-border-default">
      <!-- Left: Formulas and Definitions -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h3 class="text-lg font-bold font-headline text-text-primary">
          Calculation Formula &amp; Definitions
        </h3>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Many contractors mistakenly mark up total cost by multiplying by their target margin percentage. This common error produces a significantly lower gross margin than planned. Contractor Ledger utilizes the mathematically sound gross margin divisor formula:
          </p>
          <div class="p-3 rounded bg-canvas border border-border-default font-mono text-xs text-text-primary space-y-1">
            <div>Direct Cost = Labor + Materials + Other Direct</div>
            <div>Allocated Overhead = Fixed Amount OR (Direct Cost × Overhead % ÷ 100)</div>
            <div>Total Estimated Cost = Direct Cost + Allocated Overhead</div>
            <div class="font-bold text-brand-copper">Selling Price = Total Estimated Cost ÷ (1 − Target Margin % ÷ 100)</div>
            <div>Gross Profit = Selling Price − Total Estimated Cost</div>
          </div>
          <p>
            <strong>Overhead Allocation:</strong> Overhead can be entered as a fixed lump sum (allocated from shop/office expenses) or as a percentage of direct costs.
          </p>
        </div>
      </div>

      <!-- Right: Worked Example & Verification -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h3 class="text-lg font-bold font-headline text-text-primary">
          Worked Example
        </h3>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Illustrative job using the following entered cost assumptions:
          </p>
          <ul class="list-disc list-inside space-y-1 text-text-primary font-medium">
            <li>Direct Labor: $600.00</li>
            <li>Direct Materials: $450.00</li>
            <li>Equipment &amp; Other: $150.00</li>
            <li>Overhead: $0.00 (or included in direct rates)</li>
            <li>Target Profit Margin: 25.0%</li>
          </ul>
          <div class="p-3 rounded bg-brand-copper-light/50 border border-brand-copper-border text-xs space-y-1">
            <div class="font-semibold text-text-primary">Calculated Outputs:</div>
            <div>Total Cost = $600 + $450 + $150 = $1,200.00</div>
            <div>Divisor = 1 − 0.25 = 0.75</div>
            <div class="font-bold text-brand-copper">Selling Price = $1,200 ÷ 0.75 = $1,600.00</div>
            <div class="font-semibold text-profit-positive">Gross Profit = $1,600 − $1,200 = $400.00</div>
            <div>Actual Margin = ($400 ÷ $1,600) × 100 = 25.0%</div>
            <div>Markup on Cost = ($400 ÷ $1,200) × 100 = 33.3%</div>
          </div>
          <p class="text-xs text-text-secondary leading-relaxed">
            The result includes only entered costs and the selected overhead method. Add applicable taxes, fees, permits, and other costs separately when they are part of your estimate.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Calculators Directory -->
    <div class="pt-8 border-t border-border-default">
      <h3 class="text-sm font-bold uppercase tracking-wider text-text-primary font-headline mb-4">
        Related Financial Tools
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/calculators/labor-cost/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Labor Cost Calculator</h4>
          <p class="text-xs text-text-secondary">Determine fully burdened hourly labor rates before estimating jobs.</p>
        </a>
        <a href="/calculators/profit-margin/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Profit Margin Calculator</h4>
          <p class="text-xs text-text-secondary">Compare margins versus markups and analyze existing job quotes.</p>
        </a>
        <a href="/calculators/project-estimate/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Project Estimate Ledger</h4>
          <p class="text-xs text-text-secondary">Build an itemized multi-category estimate sheet for larger jobs.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
