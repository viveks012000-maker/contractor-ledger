---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BreakEvenCalculator } from '../../components/calculators/BreakEvenCalculator';
import { AdSlot } from '../../components/ui/AdSlot';

const title = 'Contractor Break-Even Calculator';
const description = 'Estimate the hourly billing rate and monthly revenue a contracting business needs to cover fixed costs and per-hour expenses.';
---

<BaseLayout title={title} description={description} canonicalPath="/calculators/break-even/">
  <div class="max-w-container mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/#core-calculators" class="hover:text-text-primary transition-colors">Calculators</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">Break-Even</span>
    </nav>

    <!-- Page Heading -->
    <div class="max-w-3xl space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Break-Even Rate Calculator
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Use this to estimate a rate and monthly revenue that cover your fixed monthly costs and per-hour costs. Enter realistic billable hours; this is a break-even target and does not include extra costs or profit you have not entered.
      </p>
      <p class="text-sm font-medium text-text-secondary">Enter monthly costs and expected billable hours below. The break-even results update as you change them.</p>
    </div>

    <!-- Interactive Calculator -->
    <BreakEvenCalculator client:load />

    <!-- AdSense Non-Intrusive Slot -->
    <AdSlot slotId="break-even-bottom-banner" />

    <!-- Technical Guide & Worked Example -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-6 border-t border-border-default">
      <!-- Left: Formulas and Definitions -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h3 class="text-lg font-bold font-headline text-text-primary">
          Break-Even Mechanics &amp; Capacity
        </h3>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Divide monthly fixed costs by billable hours to find the overhead assigned to each hour. Add the per-hour costs to see the rate that covers the amounts entered:
          </p>
          <div class="p-3 rounded bg-canvas border border-border-default font-mono text-xs text-text-primary space-y-1">
            <div>Fixed Overhead / Hour = Monthly Fixed Costs ÷ Billable Hours</div>
            <div class="font-bold text-brand-copper">Break-Even Rate = Fixed Overhead / Hr + Variable Cost / Hr</div>
            <div class="font-bold text-brand-copper">Monthly Revenue Required = Fixed Costs + (Variable / Hr × Hours)</div>
          </div>
          <p>
            Count only hours you expect to bill. Time spent estimating, traveling, picking up supplies, or handling administration reduces your available billable hours.
          </p>
        </div>
      </div>

      <!-- Right: Worked Example & Verification -->
      <div class="bg-surface rounded-xl border border-border-default p-6 shadow-subtle space-y-4">
        <h3 class="text-lg font-bold font-headline text-text-primary">
          Worked Example
        </h3>
        <div class="space-y-3 text-xs text-text-secondary leading-relaxed">
          <p>
            Illustrative monthly cost assumptions:
          </p>
          <ul class="list-disc list-inside space-y-1 text-text-primary font-medium">
            <li>Fixed Monthly Costs: $5,000.00 (Van note, insurance, shop space, software, phone)</li>
            <li>Expected Monthly Billable Hours: 100.0 hours</li>
            <li>Variable Cost per Hour: $20.00 / hr (fuel, tool maintenance, consumables)</li>
          </ul>
          <div class="p-3 rounded bg-brand-copper-light/50 border border-brand-copper-border text-xs space-y-1">
            <div class="font-semibold text-text-primary">Calculated Outputs:</div>
            <div>Fixed Overhead Recovery = $5,000 ÷ 100 = $50.00 / hr</div>
            <div>Variable Operating Addition = $20.00 / hr</div>
            <div class="font-bold text-brand-copper">Break-Even Rate = $50.00 + $20.00 = $70.00 / hr</div>
            <div class="font-bold text-brand-copper">Monthly Revenue Required = $5,000 + ($20 × 100) = $7,000.00 / mo</div>
          </div>
          <p class="text-text-muted">
            Under these assumptions, $70 per billed hour covers the modeled $50 overhead allocation and $20 variable cost. Additional costs or taxes not entered here are not included.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Calculators Directory -->
    <div class="pt-8 border-t border-border-default">
      <h3 class="text-sm font-bold uppercase tracking-wider text-text-primary font-headline mb-4">
        Related Financial Tools
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <a href="/calculators/labor-cost/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Labor Cost Calculator</h4>
          <p class="text-xs text-text-secondary">Determine loaded wage rates to refine your hourly variable assumptions.</p>
        </a>
        <a href="/calculators/job-pricing/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Job Pricing Calculator</h4>
          <p class="text-xs text-text-secondary">Set a target margin on top of recovered costs to generate firm profits.</p>
        </a>
        <a href="/calculators/project-estimate/" class="p-4 rounded-lg bg-surface border border-border-default hover:border-brand-copper transition-colors block">
          <h4 class="text-sm font-bold text-text-primary mb-1">Project Estimate Ledger</h4>
          <p class="text-xs text-text-secondary">Track actual overhead allocations across major contract phases.</p>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
