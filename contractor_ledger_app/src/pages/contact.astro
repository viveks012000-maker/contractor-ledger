---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact & Support Desk | Contractor Ledger';
const description = 'Get in touch with the Contractor Ledger engineering and calculation review team. Technical inquiries and operational feedback.';
---

<BaseLayout title={title} description={description} canonicalPath="/contact/">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">Contact</span>
    </nav>

    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Contact &amp; Field Desk
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Have feedback on calculation formulas, feature requests, or technical bug reports? We welcome operational suggestions from trade contractors and estimators.
      </p>
    </div>

    <!-- Official Notice Regarding Publication Blocker -->
    <div class="p-4 rounded-lg bg-canvas border border-border-default space-y-2 text-xs text-text-secondary leading-relaxed">
      <div class="flex items-center gap-2 text-text-primary font-bold text-sm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-green">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="16" x2="12" y2="12" />
          <line x1="12" y1="8" x2="12.01" y2="8" />
        </svg>
        <span>Production Domain Notice</span>
      </div>
      <p>
        In strict adherence to verification integrity, no placeholder or fabricated email addresses are published. Dedicated public support routing will be bound upon final production domain DNS activation.
      </p>
    </div>

    <!-- Contact Communication Form -->
    <div class="bg-surface rounded-xl border border-border-default p-6 sm:p-8 shadow-subtle">
      <form id="contact-form" class="space-y-4">
        <div class="space-y-1">
          <label for="contact-name" class="text-xs font-bold uppercase tracking-wider text-text-primary block">
            Your Name / Business Name
          </label>
          <input
            id="contact-name"
            type="text"
            required
            placeholder="e.g. John Miller, Miller Framing LLC"
            class="w-full h-11 px-3 rounded bg-canvas border border-border-default text-sm text-text-primary focus:outline-none focus:border-brand-green"
          />
        </div>

        <div class="space-y-1">
          <label for="contact-type" class="text-xs font-bold uppercase tracking-wider text-text-primary block">
            Inquiry Category
          </label>
          <select
            id="contact-type"
            class="w-full h-11 px-3 rounded bg-canvas border border-border-default text-sm font-medium text-text-primary focus:outline-none focus:border-brand-green"
          >
            <option>Calculation Engine Feedback / Bug Report</option>
            <option>Formula Clarification or Improvement</option>
            <option>Trade Specific Customization Request</option>
            <option>General Operational Inquiry</option>
          </select>
        </div>

        <div class="space-y-1">
          <label for="contact-message" class="text-xs font-bold uppercase tracking-wider text-text-primary block">
            Message
          </label>
          <textarea
            id="contact-message"
            rows="5"
            required
            placeholder="Describe the calculation adjustment or operational feedback..."
            class="w-full p-3 rounded bg-canvas border border-border-default text-sm text-text-primary focus:outline-none focus:border-brand-green"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full h-11 rounded bg-brand-green hover:bg-brand-green-hover text-white font-semibold text-sm transition-colors shadow-xs"
        >
          Submit Inquiry
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Inquiry received locally. Direct server delivery will be enabled upon production domain publication.');
    });
  }
</script>
