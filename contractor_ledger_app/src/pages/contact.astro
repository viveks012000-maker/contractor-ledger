---
import BaseLayout from '../layouts/BaseLayout.astro';
import { normalizeContactEmail } from '../lib/site';

const title = 'Contact Contractor Ledger';
const description = 'Contact Contractor Ledger about calculator feedback, calculation methods, or website issues.';
const contactEmail = normalizeContactEmail(import.meta.env.PUBLIC_CONTACT_EMAIL);
---

<BaseLayout title={title} description={description} canonicalPath="/contact/">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-8">
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span aria-hidden="true">/</span>
      <span class="text-text-primary font-semibold" aria-current="page">Contact</span>
    </nav>

    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Contact Contractor Ledger
      </h1>
      <p class="text-base text-text-secondary leading-relaxed">
        Send feedback about a calculation, report a website issue, or ask a question about how a result is worked out.
      </p>
    </div>

    <section class="bg-surface rounded-xl border border-border-default p-6 sm:p-8 shadow-subtle space-y-4" aria-labelledby="contact-method-heading">
      <h2 id="contact-method-heading" class="text-xl font-bold text-text-primary font-headline">Email contact</h2>
      {contactEmail ? (
        <>
          <p class="text-sm text-text-secondary leading-relaxed">
            Use the address below for calculator feedback and website questions. The link opens your email application; message delivery depends on your email provider.
          </p>
          <a
            href={`mailto:${contactEmail}`}
            class="inline-flex min-h-11 items-center justify-center px-5 rounded bg-brand-copper hover:bg-brand-copper-hover text-white text-sm font-semibold transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-copper"
          >
            Email {contactEmail}
          </a>
        </>
      ) : (
        <div class="space-y-2 text-sm text-text-secondary leading-relaxed">
          <p>A contact address has not been configured for this deployment.</p>
          <p>
            Before publishing, set <code class="rounded bg-canvas px-1.5 py-0.5 text-xs text-text-primary">PUBLIC_CONTACT_EMAIL</code> to a verified, monitored inbox. This page does not store or send messages through a web form.
          </p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
