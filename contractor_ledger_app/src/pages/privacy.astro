---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Privacy Policy | Contractor Ledger';
const description = 'Learn how Contractor Ledger processes calculator values, stores optional defaults, and uses third-party fonts.';
---

<BaseLayout title={title} description={description} canonicalPath="/privacy/">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 lg:py-14 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-text-muted" aria-label="Breadcrumbs">
      <a href="/" class="hover:text-text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-text-primary font-semibold">Privacy Policy</span>
    </nav>

    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Privacy Policy
      </h1>
      <p class="text-xs text-text-muted">
        Last updated: October 20, 2026
      </p>
    </div>

    <div class="bg-surface rounded-xl border border-border-default p-6 sm:p-8 shadow-subtle space-y-6 text-sm text-text-secondary leading-relaxed">
      <section class="space-y-2">
        <h2 class="text-lg font-bold text-text-primary font-headline">
          1. Calculator Values
        </h2>
        <p>
          Calculator values are processed in your web browser to show results. This site does not send those values to a calculation service or save job bids to an account.
        </p>
        <p>
          Your browser may still make network requests needed to load the website, such as the font request described below.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-text-primary font-headline">
          2. Saved Defaults
        </h2>
        <p>
          If you save labor, burden, overhead, or margin defaults in Cost Settings, they are stored in this browser's local storage. You can clear them in Cost Settings or remove this site's stored data in your browser settings. They are not saved to a Contractor Ledger account.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-text-primary font-headline">
          3. Fonts and Advertising
        </h2>
        <p>
          This website requests its typeface stylesheet from Google Fonts (<code class="text-xs bg-canvas px-1 py-0.5 rounded border border-border-default">fonts.googleapis.com</code>) and font files from <code class="text-xs bg-canvas px-1 py-0.5 rounded border border-border-default">fonts.gstatic.com</code>.
        </p>
        <p>
          This version does not load advertising scripts or display ads. The inactive ad placeholders do not reserve space or connect to an advertising service. If advertising is enabled in a future version, this policy should be updated before it is activated.
        </p>
      </section>

      <section class="space-y-2">
        <h2 class="text-lg font-bold text-text-primary font-headline">
          4. Contact Information
        </h2>
        <p>
          See the <a href="/contact/" class="text-brand-copper font-semibold hover:underline">Contact page</a> for current contact options. An email link is shown only when an address is configured.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
