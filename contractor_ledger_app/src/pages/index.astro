---
import BaseLayout from '../layouts/BaseLayout.astro';
import { JobPricingCalculator } from '../components/calculators/JobPricingCalculator';
import { AdSlot } from '../components/ui/AdSlot';

const title = 'Contractor Ledger | Free Contractor Estimating Calculators';
const description = 'Free estimating calculators for U.S. contractors. Price jobs, estimate labor and material costs, check break-even revenue, and build project estimates.';

const calculators = [
  {
    title: 'Job Pricing',
    href: '/calculators/job-pricing/',
    description: 'Find what to charge for a job from its costs and your target margin.',
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" /><line x1="8" y1="6" x2="16" y2="6" /><line x1="16" y1="14" x2="16" y2="14" /><line x1="12" y1="14" x2="12" y2="14" /><line x1="8" y1="14" x2="8" y2="14" /><line x1="16" y1="18" x2="16" y2="18" /><line x1="12" y1="18" x2="12" y2="18" /><line x1="8" y1="18" x2="8" y2="18" /></svg>`,
  },
  {
    title: 'Labor Cost',
    href: '/calculators/labor-cost/',
    description: 'Calculate what your crew really costs per hour, including burden and overtime.',
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>`,
  },
  {
    title: 'Profit Margin',
    href: '/calculators/profit-margin/',
    description: 'See how price, profit, margin, and markup compare.',
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19" /><circle cx="6.5" cy="6.5" r="2.5" /><circle cx="17.5" cy="17.5" r="2.5" /></svg>`,
  },
  {
    title: 'Break-Even',
    href: '/calculators/break-even/',
    description: 'Find the monthly revenue and hourly rate needed to cover costs.',
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10M12 3v18M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>`,
  },
  {
    title: 'Material Markup',
    href: '/calculators/material-markup/',
    description: 'Set a selling price for materials, including an allowance for waste.',
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>`,
  },
  {
    title: 'Project Estimate',
    href: '/calculators/project-estimate/',
    description: 'Build one project estimate from labor, materials, equipment, and subcontractors.',
    iconSvg: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1-2-1Z"/><path d="M8 7h8M8 11h8M8 15h5"/></svg>`,
  },
];
---

<BaseLayout title={title} description={description} canonicalPath="/" includeBrandSchema={true}>
  <!-- Practical, light-first introduction with a live calculator preview -->
  <section class="home-hero w-full bg-canvas text-text-primary">
    <div class="max-w-container mx-auto px-4 sm:px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-6 flex flex-col justify-center pr-0 lg:pr-4 lg:self-stretch">
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.16em] text-brand-copper">
          Free estimating tools for U.S. contractors
        </p>
        <h1 class="home-hero-title text-4xl sm:text-5xl lg:text-[52px] font-extrabold text-text-primary tracking-[-0.04em] leading-[1.08] font-headline mb-5">
          Know your costs. Price the job.
        </h1>
        <p class="text-lg text-text-secondary max-w-xl leading-relaxed mb-8">
          Use six free calculators to price jobs, estimate labor and material costs, and build bids from your own numbers.
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a
            href="#core-calculators"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md bg-brand-copper text-white font-semibold text-sm hover:bg-brand-copper-hover transition-colors shadow-subtle focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-copper"
          >
            <span>Choose a Calculator</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>

        </div>

        <div class="mt-10 pt-6 border-t border-border-default flex flex-wrap items-center gap-x-6 gap-y-3 text-text-secondary text-sm font-medium">
          <div class="flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-copper">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              <polyline points="9 12 11 14 15 10" />
            </svg>
            <span>Transparent formulas</span>
          </div>

          <div class="flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-copper">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <span>No account required</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Live Interactive Job Pricing Preview -->
      <div class="hidden lg:block lg:col-span-6 w-full">
        <JobPricingCalculator isPreview={true} client:visible />
      </div>
    </div>
    </div>
  </section>

  <!-- PART TWO: THE SIX CORE CALCULATORS DIRECTORY -->
  <section class="w-full max-w-container mx-auto px-4 sm:px-6 py-12 lg:py-16 border-t border-border-default/60 scroll-mt-24" id="core-calculators">
    <div class="max-w-2xl mb-8">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-text-primary tracking-tight font-headline">
        Calculators for everyday estimating
      </h2>
      <p class="text-base text-text-secondary mt-1 leading-relaxed">
        Pick the tool that matches the number you need for this bid.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {calculators.map(c => (
        <a
          href={c.href}
          class="group bg-surface rounded-xl p-7 border border-border-default shadow-card hover:border-brand-copper transition-colors flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center gap-3 mb-3">
              <div
                class="w-11 h-11 rounded-lg bg-brand-copper-light flex items-center justify-center text-brand-copper group-hover:bg-brand-copper group-hover:text-white transition-colors"
                set:html={c.iconSvg}
              />
              <h3 class="text-xl font-bold font-headline text-text-primary group-hover:text-brand-copper transition-colors tracking-tight">
                {c.title}
              </h3>
            </div>
            <p class="text-sm text-text-secondary leading-relaxed min-h-[44px]">
              {c.description}
            </p>
          </div>

          <div class="pt-4 border-t border-border-default/60 mt-5 flex items-center justify-between text-sm font-semibold text-brand-copper">
            <span>Open Calculator</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Non-intrusive AdSense Slot Placement -->
  <section class="max-w-container mx-auto px-4 sm:px-6">
    <AdSlot slotId="homepage-middle-leaderboard" />
  </section>

  <!-- PART THREE: WORKED MATHEMATICAL ILLUSTRATION (ACCURATE MARGIN EXAMPLE) -->
  <section class="w-full max-w-container mx-auto px-4 sm:px-6 py-12 lg:py-16 border-t border-border-default/60">
    <div class="p-8 md:p-10 rounded-xl bg-surface border border-border-default shadow-card">
      <div class="max-w-2xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-text-primary tracking-tight font-headline mb-2">
          How Profit Margin Pricing Works
        </h2>
        <p class="text-sm sm:text-base text-text-secondary leading-relaxed">
          Selling price is computed by dividing total job costs by <code class="font-semibold text-text-primary">(1 − Target Margin % ÷ 100)</code>, ensuring your actual dollar return matches your intended yield.
        </p>
      </div>

      <!-- Worked Numerical Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 p-6 rounded-lg bg-canvas border border-border-default mb-8">
        <div>
          <span class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">
            Total Job Cost
          </span>
          <span class="text-2xl font-bold text-text-primary tabular-nums tracking-tight">
            $1,200.00
          </span>
          <span class="block text-xs text-text-muted mt-1">Labor, supplies &amp; gear</span>
        </div>

        <div>
          <span class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">
            Target Profit Margin
          </span>
          <span class="text-2xl font-bold text-profit-positive tabular-nums tracking-tight">
            25.0%
          </span>
          <span class="block text-xs text-text-muted mt-1">Yield on selling price</span>
        </div>

        <div>
          <span class="block text-xs font-semibold text-brand-copper uppercase tracking-wider mb-1">
            Recommended Selling Price
          </span>
          <span class="text-3xl sm:text-4xl font-bold text-brand-copper tabular-nums tracking-tight leading-none block">
            $1,600.00
          </span>
          <span class="block text-xs text-text-secondary font-medium mt-1">Client billed figure</span>
        </div>

        <div>
          <span class="block text-xs font-semibold text-text-secondary uppercase tracking-wider mb-1">
            Estimated Gross Profit
          </span>
          <span class="text-2xl font-bold text-profit-positive tabular-nums tracking-tight">
            $400.00
          </span>
          <span class="block text-xs text-text-muted mt-1">Exact 25% of $1,600.00</span>
        </div>
      </div>

      <!-- Allocation Split Bar -->
      <div class="space-y-3">
        <div class="flex justify-between items-end text-xs font-medium text-text-secondary">
          <span>Contract Allocation Breakdown</span>
          <span class="font-bold text-text-primary">$1,600.00 Total Job Value</span>
        </div>

        <div class="profit-breakdown-track w-full h-4 rounded flex overflow-hidden">
          <div class="h-full bg-text-secondary" style="width: 75%;" title="Cost Basis: $1,200.00 (75%)"></div>
          <div class="h-full bg-profit-positive" style="width: 25%;" title="Gross Profit: $400.00 (25%)"></div>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs pt-1">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-sm bg-text-secondary"></span>
              <span class="text-text-secondary">Total Job Cost:</span>
              <span class="font-bold text-text-primary">$1,200.00</span>
              <span class="text-text-muted">(75.0%)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-sm bg-profit-positive"></span>
              <span class="text-text-secondary">Gross Profit:</span>
              <span class="font-bold text-profit-positive">$400.00</span>
              <span class="text-text-muted">(25.0%)</span>
            </div>
          </div>
          <div class="text-xs font-semibold text-text-secondary">
            Markup Equivalent: <span class="text-text-primary">33.3%</span> on Cost
          </div>
        </div>
      </div>

      <!-- Formula Pill -->
      <div class="mt-6 p-4 rounded-lg bg-canvas border border-border-default flex items-center gap-3 text-xs text-text-secondary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-copper shrink-0">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z" />
          <path d="M8 7h8M8 11h8" />
        </svg>
        <span>
          <strong>Defensible Standard:</strong> <code class="text-text-primary font-semibold">Selling Price = Total Estimated Cost ÷ (1 − Target Margin % ÷ 100)</code>
        </span>
      </div>
    </div>
  </section>
</BaseLayout>
