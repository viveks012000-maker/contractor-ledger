---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Page Not Found (404) | Contractor Ledger';
const description = 'The requested calculator or ledger page could not be located. Explore our six trade financial calculators.';
---

<BaseLayout title={title} description={description} robots="noindex, follow">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center space-y-6">
    <div class="w-16 h-16 rounded-2xl bg-brand-green-light text-brand-green flex items-center justify-center mx-auto shadow-xs">
      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
    </div>

    <div class="space-y-2">
      <span class="text-xs font-bold uppercase tracking-widest text-brand-green">Error 404</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight font-headline">
        Ledger Entry Not Found
      </h1>
      <p class="text-sm sm:text-base text-text-secondary max-w-md mx-auto leading-relaxed">
        The route you navigated to does not exist or has been moved within the ledger directory.
      </p>
    </div>

    <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded bg-brand-green hover:bg-brand-green-hover text-white text-xs font-semibold transition-colors shadow-xs"
      >
        Return to Homepage
      </a>
      <a
        href="/#core-calculators"
        class="px-5 py-2.5 rounded border border-border-default hover:bg-canvas text-text-primary text-xs font-semibold transition-colors"
      >
        Browse All 6 Calculators
      </a>
    </div>

    <div class="pt-8 border-t border-border-default/60 max-w-lg mx-auto text-left">
      <h2 class="text-xs font-bold uppercase tracking-wider text-text-primary mb-3">
        Quick Calculator Links:
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
        <a href="/calculators/job-pricing/" class="text-brand-green hover:underline">→ Job Pricing Calculator</a>
        <a href="/calculators/labor-cost/" class="text-brand-green hover:underline">→ Labor Cost Calculator</a>
        <a href="/calculators/profit-margin/" class="text-brand-green hover:underline">→ Profit Margin vs. Markup</a>
        <a href="/calculators/break-even/" class="text-brand-green hover:underline">→ Break-Even Calculator</a>
        <a href="/calculators/material-markup/" class="text-brand-green hover:underline">→ Material Markup &amp; Waste</a>
        <a href="/calculators/project-estimate/" class="text-brand-green hover:underline">→ Project Estimate Bid Sheet</a>
      </div>
    </div>
  </div>
</BaseLayout>
